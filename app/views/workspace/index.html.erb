<% content_for :title, "Chutney Lab — Better Gherkin, instantly" %>

<div class="app-shell"
     data-controller="workspace"
     data-workspace-lint-url-value="<%= lint_path %>">
  <header class="topbar">
    <a class="brand" href="/" aria-label="Chutney Lab home">
      <span class="brand-mark" aria-hidden="true"><img src="/mr_pickle.png" alt="" width="42" height="43"></span>
      <span class="brand-copy"><strong>chutney</strong><small>LAB</small></span>
    </a>

    <div class="topbar-center">
      <span class="workspace-kicker">Playground</span>
      <span class="topbar-divider"></span>
      <label class="filename-label" for="feature-file-name">Filename</label>
      <input id="feature-file-name"
             class="filename-input"
             value="<%= @initial_name %>"
             maxlength="120"
             data-workspace-target="filename"
             data-action="input->workspace#markDirty blur->workspace#normalizeFilename"
             aria-label="Feature filename">
      <span class="dirty-dot" data-workspace-target="dirtyIndicator" title="Unsaved changes" hidden></span>
    </div>

    <nav class="topbar-actions" aria-label="Workspace actions">
      <button class="button rules-trigger" type="button" data-action="workspace#openRuleSettings" aria-haspopup="dialog" aria-controls="rule-settings">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h10m4 0h2M4 17h2m4 0h10M14 4v6M6 14v6"/></svg>
        <span class="rules-trigger-label">Rules</span>
        <span class="rules-trigger-count" data-workspace-target="rulesCount"><%= ChutneyRuleCatalog.default_enabled_names.size %>/<%= ChutneyRuleCatalog.names.size %></span>
      </button>
      <a href="https://www.usechutney.com/docs" class="nav-link" target="_blank" rel="noreferrer">Docs <span aria-hidden="true">↗</span></a>
      <button class="button button-ghost button-icon" type="button" data-action="workspace#download" title="Download feature file" aria-label="Download feature file">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14"/></svg>
      </button>
      <button class="button button-primary" type="button" data-action="workspace#save" data-workspace-target="saveButton">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h12l2 2v14H5V4Zm3 0v6h8V4M8 20v-6h8v6"/></svg>
        <span data-workspace-target="saveLabel">Save file</span>
      </button>
    </nav>
  </header>

  <main class="workspace">
    <aside class="file-rail" aria-label="Feature files">
      <div class="rail-heading">
        <div>
          <span class="eyebrow">Workspace</span>
          <h2>Feature files</h2>
        </div>
        <button class="round-button" type="button" data-action="workspace#newFile" aria-label="Create a new feature file" title="New feature file">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        </button>
      </div>

      <div class="file-list" data-workspace-target="fileList">
        <div class="empty-files" data-workspace-target="emptyState">
          <span class="empty-files-icon" aria-hidden="true">✦</span>
          <p>Features saved in this browser will live here.</p>
        </div>
      </div>

      <div class="rail-footer">
        <input type="file" accept=".feature,text/plain" hidden data-workspace-target="fileInput" data-action="change->workspace#importFile">
        <button class="import-button" type="button" data-action="workspace#chooseFile">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0L7 9m5-5 5 5M5 20h14"/></svg>
          Upload .feature
        </button>
        <p>Files are stored only in this browser.</p>
      </div>
    </aside>

    <section class="editor-column" aria-label="Gherkin editor">
      <div class="panel-toolbar">
        <div class="toolbar-title">
          <span class="live-dot"></span>
          <strong>Gherkin editor</strong>
          <span class="language-chip">GHERKIN</span>
        </div>
        <div class="editor-meta">
          <span data-workspace-target="lineCount">1 line</span>
          <span class="meta-divider"></span>
          <span>UTF-8</span>
        </div>
      </div>

      <div class="editor-wrap">
        <div class="line-numbers" aria-hidden="true"><div data-workspace-target="gutter"></div></div>
        <div class="code-surface">
          <pre class="syntax-layer" aria-hidden="true" data-workspace-target="highlight"></pre>
          <textarea class="code-input"
                    data-workspace-target="editor"
                    data-action="input->workspace#editorChanged scroll->workspace#syncScroll keydown->workspace#handleKeydown"
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                    aria-label="Gherkin feature file editor"><%= @initial_content %></textarea>
        </div>
      </div>

      <div class="editor-footer">
        <span><kbd>⌘</kbd><kbd>S</kbd> to save</span>
        <span><kbd>⌘</kbd><kbd>↵</kbd> to run Chutney</span>
      </div>
    </section>

    <aside class="results-panel" aria-label="Chutney results">
      <div class="panel-toolbar results-toolbar">
        <div class="toolbar-title">
          <span class="result-mark" data-workspace-target="resultMark">✓</span>
          <strong>Chutney report</strong>
        </div>
        <span class="issue-count" data-workspace-target="issueCount">Ready</span>
      </div>

      <div class="report-summary" data-workspace-target="summary">
        <div class="summary-orbit"><span>✓</span></div>
        <div>
          <span class="eyebrow">Ready to taste</span>
          <h2>Run your first check</h2>
          <p>Chutney will review the structure, clarity and maintainability of your Gherkin.</p>
        </div>
      </div>

      <div class="issue-list" data-workspace-target="issueList" aria-live="polite"></div>

      <div class="report-spacer"></div>
      <div class="run-area">
        <div class="run-meta">
          <span data-workspace-target="lastRun">Not checked yet</span>
          <span>Chutney <%= Chutney::VERSION %></span>
        </div>
        <button class="run-button" type="button" data-action="workspace#lint" data-workspace-target="runButton">
          <span class="run-icon" aria-hidden="true">▶</span>
          <span data-workspace-target="runLabel">Run Chutney</span>
          <kbd>⌘ ↵</kbd>
        </button>
      </div>
    </aside>
  </main>

  <div class="rules-overlay" data-workspace-target="rulesOverlay" data-action="click->workspace#closeRuleSettings" hidden>
    <aside id="rule-settings" class="rules-drawer" role="dialog" aria-modal="true" aria-labelledby="rule-settings-title" data-action="click->workspace#keepRuleSettingsOpen">
      <header class="rules-header">
        <div>
          <span class="eyebrow">Local preferences</span>
          <h2 id="rule-settings-title">Season your checks</h2>
          <p>Choose which Chutney rules run for this browser.</p>
        </div>
        <button type="button" class="docs-close" data-action="workspace#closeRuleSettings" aria-label="Close rule settings">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
      </header>

      <div class="rules-controls">
        <label class="rules-search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6"/><path d="m16 16 4 4"/></svg>
          <span class="visually-hidden">Search linting rules</span>
          <input type="search" placeholder="Find a rule…" autocomplete="off" data-workspace-target="rulesSearch" data-action="input->workspace#filterRules">
        </label>
        <button type="button" data-action="workspace#enableAllRules">Enable all</button>
        <button type="button" data-action="workspace#restoreDefaultRules">Restore defaults</button>
      </div>

      <div class="rules-content">
        <div class="syntax-rule-note">
          <span class="syntax-lock" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
          </span>
          <div><strong>Gherkin syntax</strong><p>Parsing and syntax safety are always on.</p></div>
          <span class="always-on-chip">Always on</span>
        </div>

        <% @rule_groups.each do |category, rules| %>
          <section class="rule-group" data-workspace-target="ruleGroup">
            <header><h3><%= category %></h3><span><%= rules.size %> rules</span></header>
            <div class="rule-options">
              <% rules.each do |rule| %>
                <article class="rule-option <%= "is-enabled" if rule.enabled_by_default %>" data-rule-name="<%= rule.name %>" data-rule-search="<%= "#{rule.title} #{rule.summary} #{category}".downcase %>">
                  <label class="rule-toggle-label">
                    <input type="checkbox"
                           value="<%= rule.name %>"
                           <%= "checked" if rule.enabled_by_default %>
                           data-default-enabled="<%= rule.enabled_by_default %>"
                           data-workspace-target="ruleToggle"
                           data-action="change->workspace#ruleSettingChanged">
                    <span class="rule-switch" aria-hidden="true"><span></span></span>
                    <span class="rule-copy">
                      <strong><%= rule.title %></strong>
                      <small><%= rule.summary %></small>
                    </span>
                  </label>
                  <% if rule.documentation_url %>
                    <button class="rule-guide-button" type="button" data-action="workspace#openRuleGuideFromSettings" data-documentation-url="<%= rule.documentation_url %>" aria-label="Read <%= rule.title %> guide">Guide <span aria-hidden="true">↗</span></button>
                  <% end %>
                  <% if rule.settings.any? %>
                    <div class="rule-configuration">
                      <% rule.settings.each do |setting| %>
                        <% input_id = "rule-option-#{rule.name}-#{setting.key}" %>
                        <label class="rule-field" for="<%= input_id %>">
                          <span><%= setting.label %></span>
                          <% if setting.type == :groups %>
                            <textarea id="<%= input_id %>"
                                      rows="2"
                                      placeholder="<%= setting.placeholder %>"
                                      <%= "disabled" unless rule.enabled_by_default %>
                                      data-rule-name="<%= rule.name %>"
                                      data-option-key="<%= setting.key %>"
                                      data-option-type="<%= setting.type %>"
                                      data-default-value="<%= setting.input_value %>"
                                      data-workspace-target="ruleOption"
                                      data-action="change->workspace#ruleOptionChanged"><%= setting.input_value %></textarea>
                          <% else %>
                            <input id="<%= input_id %>"
                                   type="<%= setting.type == :integer ? "number" : "text" %>"
                                   value="<%= setting.input_value %>"
                                   placeholder="<%= setting.placeholder %>"
                                   <% if setting.type == :integer %>
                                     min="<%= setting.min %>"
                                     max="<%= setting.max %>"
                                   <% end %>
                                   <%= "disabled" unless rule.enabled_by_default %>
                                   autocomplete="off"
                                   spellcheck="false"
                                   data-rule-name="<%= rule.name %>"
                                   data-option-key="<%= setting.key %>"
                                   data-option-type="<%= setting.type %>"
                                   data-default-value="<%= setting.input_value %>"
                                   data-workspace-target="ruleOption"
                                   data-action="change->workspace#ruleOptionChanged">
                          <% end %>
                          <small><%= setting.help %></small>
                        </label>
                      <% end %>
                    </div>
                  <% end %>
                </article>
              <% end %>
            </div>
          </section>
        <% end %>
        <div class="rules-empty" data-workspace-target="rulesEmpty" hidden>No rules match that search.</div>
      </div>

      <footer class="rules-footer">
        <div><strong data-workspace-target="rulesSummary"><%= ChutneyRuleCatalog.default_enabled_names.size %> of <%= ChutneyRuleCatalog.names.size %> optional checks enabled</strong><small>Stored only in this browser</small></div>
        <button class="button button-primary" type="button" data-action="workspace#closeRuleSettings">Done</button>
      </footer>
    </aside>
  </div>

  <div class="docs-overlay" data-workspace-target="docsOverlay" data-action="click->workspace#closeDocumentation" hidden>
    <aside class="docs-drawer" role="dialog" aria-modal="true" aria-labelledby="rule-guide-title" data-action="click->workspace#keepDocumentationOpen">
      <header class="docs-header">
        <div>
          <span class="eyebrow">Chutney rule guide</span>
          <h2 id="rule-guide-title" data-workspace-target="docsTitle">Rule documentation</h2>
        </div>
        <button type="button" class="docs-close" data-action="workspace#closeDocumentation" aria-label="Close rule documentation">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
      </header>
      <div class="docs-content" data-workspace-target="docsContent">
        <div class="docs-loading">Loading rule guide…</div>
      </div>
      <footer class="docs-footer">
        <a href="https://www.usechutney.com/docs/rules" target="_blank" rel="noreferrer" data-workspace-target="docsExternalLink">View on usechutney.com <span aria-hidden="true">↗</span></a>
      </footer>
    </aside>
  </div>

  <div class="toast" role="status" aria-live="polite" data-workspace-target="toast" hidden></div>
</div>
